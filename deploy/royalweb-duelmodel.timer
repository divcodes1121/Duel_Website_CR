[Unit]
Description=Retrain the Deckkies duel win model daily
Requires=royalweb-duelmodel.service

[Timer]
# DAILY: a day of new duels is ~3,000 games against ~360,000, so the model
# moves slowly; a daily fit keeps new cards and balance changes in it within a
# day. 05:50 UTC keeps it off the duel index (02/4:10), the cluster rebuild
# (00/4:40), retention (01:30), the backup (02:30) and the ladder-raw purge
# (03:30).
OnCalendar=*-*-* 05:50:00
RandomizedDelaySec=600
Persistent=true
Unit=royalweb-duelmodel.service

[Install]
WantedBy=timers.target
