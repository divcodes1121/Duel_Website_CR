[Unit]
# A verified, compressed copy of the bot's database, daily (server/db_backup.py).
#
# Online-backup-API snapshot (one read transaction; the bot keeps writing) ->
# quick_check + row counts on the COPY -> zstd, re-read with `zstd -t`, SHA-256
# -> a tar.zst of the irreplaceable extras (bot code + .env, royalweb env,
# Caddyfile, units, .tracking/.meta_history/.duo_pairs/.data_ledger DBs,
# ml/results, sampler state) -> keeps only the newest verified copy in
# /var/backups/deckkies. It REFUSES if the disk cannot hold the snapshot plus
# 20 GB, and it never touches anything outside that directory.
#
# THIS IS NOT THE OFF-BOX BACKUP ON ITS OWN. A copy on this disk dies with this
# disk. deploy/pull-backup.ps1 (a scheduled task on the owner's PC) fetches it,
# re-hashes it and calls `db_backup.py --mark-pulled`; the console shows how
# long ago an off-box copy was last confirmed.
Description=Deckkies daily database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/royalweb/server
EnvironmentFile=/etc/royalweb.env
ExecStart=/usr/bin/python3 -u db_backup.py --run
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
SuccessExitStatus=0
TimeoutStartSec=10800
StandardOutput=append:/var/log/clashbot/backup.log
StandardError=append:/var/log/clashbot/backup.log

[Install]
WantedBy=multi-user.target
