# Copy to .env.local and fill in. Only VITE_-prefixed values may be public:
# Vite inlines them into the browser bundle at build time, so the prefix IS the
# boundary between "anyone can read this" and "server only".

# Supabase (Project Settings -> API Keys). Publishable key, never the secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The analytics API on the Contabo box. Public.
VITE_ANALYTICS_BASE=https://api.deckkies.com

# SERVER ONLY - set these in Vercel, never with a VITE_ prefix:
#   ANALYTICS_ORIGIN   https://api.deckkies.com
#   CLASH_API_KEY      read from /etc/royalweb.env on the VPS
#   OIE_ALLOWLIST      comma-separated usernames
